# Application Configuration
APP_NAME="Facial Recognition & Mood Analytics System"
API_PREFIX="/api"
DATABASE_URL="sqlite:///./facial_recognition.db"
SECRET_KEY="generate-a-secure-random-key-here-for-production"
ENCRYPTION_KEY="gAAAAABl-sample-fernet-key-32-bytes-base64="

# Storage Paths
PROTECTED_STORAGE_DIR="./protected_storage/faces"

# Computer Vision & Verification Settings
EXTERNAL_CAMERA_INDEX=1
BUILTIN_CAMERA_INDEX=0
ENABLE_GPU=false
SIMILARITY_MATCH_THRESHOLD=0.72
SIMILARITY_UNCERTAIN_THRESHOLD=0.58
MIN_VERIFICATION_FRAMES=8
QUALITY_MIN_SHARPNESS=60.0
QUALITY_MIN_FACE_SIZE=80
LIVENESS_THRESHOLD=0.65
ENABLE_EXPRESSION_ANALYSIS=true
REQUIRE_EXPLICIT_CONSENT=false
AUTO_REGISTER_VERIFIED_NEW=true
DATA_RETENTION_DAYS=90
